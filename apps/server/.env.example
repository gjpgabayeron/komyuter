# Postgres connection string printed by `supabase status` (local stack)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Local Supabase API gateway (printed by `supabase status`)
SUPABASE_URL=http://127.0.0.1:54321

# Service role key (printed by `supabase status`)
SUPABASE_SERVICE_ROLE_KEY=

# Seeded admin identity (must match supabase/seed.sql)
ADMIN_EMAIL=admin@komyuter.ph
# DEV-ONLY default committed in supabase/seed.sql; the CLI cannot interpolate env
# vars into seed files. Change this before any shared/production deployment.
ADMIN_PASSWORD=komyuter-admin-dev

# HTTP port for the Fastify server
PORT=3000

# Dev-credential gate: true allows the documented dev credential
# (admin@komyuter.ph / komyuter-admin-dev) to sign in. Keep false anywhere
# shared or production — the gate refuses that well-known credential.
ALLOW_DEV_CREDENTIAL=false

# Comma-separated Origin allowlist for the admin API (US4 origin guard).
ADMIN_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Mapbox secret token for road-network snapping in the Route Plotting
# page. When absent, the admin snapping proxy falls back to straight-line
# geometry (snapped: false, warning: "no_token").
# MAPBOX_SECRET_TOKEN=
