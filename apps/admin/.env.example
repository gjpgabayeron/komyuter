# Admin app environment (apps/admin/.env — gitignored; copy this file to .env).
#
# See specs/005-admin-appshell/contracts/ui-shell.md §1 for the full contract.
#
# Base URL of the Fastify backend. Used for auth (POST /api/auth/login,
# GET /api/auth/me) and all future admin API calls.
#
# NOTE: VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY are NOT used by the admin
# app — auth is backend-proxied (docs/adr/0006-…). When the backend is
# unreachable the shell still renders; sign-in fails with an honest error
# toast (SC-010).
VITE_API_URL=http://localhost:3000
