    {
      "id": "claim_d02ceb9d6e64426db5a22af6c4aef9c8",
      "statement": "buildApp registers createOriginGuard(deps.env.ADMIN_ORIGINS) as an onRequest hook immediately after @fastify/cors; the guard splits the comma-separated allowlist, trims and drops empty entries, lets OPTIONS preflights and requests without an Origin header pass, and rejects any other Origin with 403 FORBIDDEN \"Origin not allowed\" — so omitting the admin SPA's real origin from ADMIN_ORIGINS breaks browser calls while curl-style and test calls keep working.",
      "evidence": [
        {
          "resource": "repo://apps/server/src/api/app.ts#L41-L45",
          "version": "repo-lines-v1:sha256:d2c1f8176d07f8648b13614b1576ba1deb64b115c9590ff6ba52fcd17320d8f7:"
