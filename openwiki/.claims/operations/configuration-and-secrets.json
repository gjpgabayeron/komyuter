    {
      "id": "claim_01fb48a477cb4d6883c479bcc1a215b6",
      "statement": "The Env object is wired into runtime dependencies by index.ts: createDb(env.DATABASE_URL) builds the pg Pool plus Drizzle instance, createSupabaseAdmin(env.SUPABASE_URL, env.SUPABASE_SERVICE_ROLE_KEY) builds a service-role Supabase client with persistSession and autoRefreshToken disabled, both are passed together with env into buildApp as AppDeps, and the listener uses env.PORT with a hard-coded 0.0.0.0 host.",
      "evidence": [
