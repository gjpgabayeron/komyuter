    {
      "id": "claim_2c224061556c4d8989a19d8ed360e8c2",
      "statement": "The `module: \"ESNext\"` plus `moduleResolution: \"Bundler\"` pair inherited from `base.json` is what permits the extensionless relative imports used throughout the preset-consuming projects (`\".../api/app\"` in the server entrypoint, `\"./types/geometry\"` in the shared barrel, `\"./components\"` in the UI barrel), which `NodeNext` resolution would reject; changing `module`/`moduleResolution` in `base.json` would therefore affect `apps/server`, `packages/shared` and `packages/ui` at the same time.",
      "evidence": [
        {
          "resource": "repo://apps/server/src/index.ts#L1-L4",
          "version": "repo-lines-v1:sha256:edb4ab6eb41bd6966b21633d284a60d196d6bae12f48cf6e72e31b3f6e79e8dd:"
