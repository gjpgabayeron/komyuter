  "claims": [
    {
      "id": "claim_65b49eb7169f4c07830c525338fa3bdb",
      "statement": "`@repo/typescript-config` (packages/typescript-config) publishes exactly three tsconfig presets: `base.json`, which is the root preset and sets `strict: true`, `module: \"ESNext\"`, `moduleResolution: \"Bundler\"`, `isolatedModules: true`, `declaration` + `declarationMap`, `skipLibCheck: true`, `esModuleInterop`, `composite: false` and explicitly `noUnusedLocals: false` / `noUnusedParameters: false` (no `target`, `lib`, `jsx` or `noEmit`); `vite.json`, which extends base and adds `target: \"ESNext\"`, `lib: [\"ESNext\", \"DOM\"]`, `noEmit: true`, flips `noUnusedLocals`/`noUnusedParameters` to `true` and adds `noImplicitReturns: true`; and `react-library.json`, which extends base and adds only `jsx: \"react-jsx\"`.",
      "evidence": [
        {
          "resource": "repo://packages/typescript-config/base.json",
          "version": "repo-file-v1:sha256:c8db54ca0e4ab8f1171b75e56b1b10960dacc7067078ca022104ca3525269d5d"
        },
        {
          "resource": "repo://packages/typescript-config/react-library.json",
          "version": "repo-file-v1:sha256:583d7792ec2991008fbaec247c4126f51a07c5d5c8f16450ca4877256fcbfa63"
        },
        {
