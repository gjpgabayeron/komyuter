    {
      "id": "claim_4f870a73a76047cf8c3e001999082633",
      "statement": "The HTTP surface is split into public routes (GET /api/status and the /api/auth/login, /api/auth/me and /api/auth/logout routes) and one plugin mounted at /api/admin carrying the admin CRUD, export and Mapbox routes, whose preHandler hook is the admin auth guard.",
      "evidence": [
        {
          "resource": "repo://apps/server/src/api/index.ts#L14-L36",
          "version": "repo-lines-v1:sha256:cc5d728f37999836f5a5550cc2b48a7d7d26875865535c4f961dd93326c9549b:"
