    {
      "id": "claim_ffa13ead24894c959c341de1d6f1bacf",
      "statement": "The SPA mirrors the envelope in axios interceptors: a success envelope is unwrapped to data, a failure envelope or raw error is rejected as an ApiError carrying code, message and status, and a 401 on anything other than the login call clears the stored token and emits the session-expired signal that drives the auth redirect.",
      "evidence": [
        {
          "resource": "repo://apps/admin/src/lib/api.ts#L45-L101",
          "version": "repo-lines-v1:sha256:1190aedb38f570ca6849e2f58c9ddf4fc17a7880546000275f157f31dc4e973d:"
        }
      ]
    },
    {
      "id": "claim_83cfb265012049b0b297add4d9bf4046",
      "statement": "Two endpoints deliberately do not use the response envelope: GET /api/admin/export/dataset returns the assembled dataset as a raw JSON attachment with Content-Disposition, and POST /api/auth/logout answers a bare 204 for every token state.",
