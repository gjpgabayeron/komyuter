    {
      "id": "claim_ca77c1b1fdb24715a67bad921f5105a5",
      "statement": "Admin authorization is one rule applied in one place: a strict Bearer token is verified with supabase.auth.getUser and the user id must have a matching admin_users row via isAdminUserId — the same lookup used by login and /api/auth/me — producing 401 UNAUTHORIZED for a missing or invalid token and 403 FORBIDDEN for a valid non-admin; the guard stores request.adminUserId, which the onResponse hook logs as a structured \"admin request completed\" line.",
      "evidence": [
        {
          "resource": "repo://apps/server/src/api/app.ts#L47-L64",
          "version": "repo-lines-v1:sha256:cff27dd91ad5ee75f2372c94b43ab65a1c58021a63c1b9397572fcff5764467b:"
        },
