    {
      "id": "claim_5c74e36fa31b48cabaf7236f4f6c32ff",
      "statement": "The response envelope is enforced centrally in buildApp's error handler (ApiError maps to its own status code, Zod validation failures become 422 VALIDATION_ERROR, anything else becomes 500 INTERNAL with a generic message) and its vocabulary is the closed ERROR_CODES set exported by @komyuter/shared.",
      "evidence": [
        {
          "resource": "repo://apps/server/src/api/app.ts#L66-L86",
          "version": "repo-lines-v1:sha256:401b2f221849f774fe419ee255b3b18ec9e205c59a17cd725e87bc1e1a913674:"
