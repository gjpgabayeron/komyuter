          "version": "repo-lines-v1:sha256:bd5a87af1b3598a4fd939d179933aff0ddedc748ba42777b267d364d0e39a5af:"
        }
      ]
    },
    {
      "id": "claim_24c9e286b2dc49aa9980a114be061942",
      "statement": "Server configuration is validated once at startup by a Zod schema: DATABASE_URL, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, ADMIN_EMAIL and ADMIN_PASSWORD are required; PORT (3000) and ADMIN_ORIGINS are defaulted; MAPBOX_SECRET_TOKEN and the boolean ALLOW_DEV_CREDENTIAL (default false) are optional; a .env file is loaded only when DATABASE_URL is unset, and any failure throws a joined \"Invalid environment\" error so the process never starts half-configured.",
      "evidence": [
        {
          "resource": "repo://apps/server/.env.example",
          "version": "repo-file-v1:sha256:01bde95af6a68cddf82f643f9cee5d85bd3a4af29ea529cd6e79d88045bd6399"
