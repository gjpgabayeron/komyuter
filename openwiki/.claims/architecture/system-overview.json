    {
      "id": "claim_b40e3d6a3ba74dfdb6549bc9fc45265d",
      "statement": "Because the browser calls the API cross-origin with no Vite dev proxy, @fastify/cors is registered with origin: true and an onRequest origin guard runs immediately after it: a request whose Origin header is not in ADMIN_ORIGINS (default http://localhost:5173 and http://127.0.0.1:5173) is rejected with 403 FORBIDDEN, while origin-less requests and OPTIONS preflights pass.",
      "evidence": [
        {
          "resource": "repo://apps/server/src/api/app.ts#L41-L45",
          "version": "repo-lines-v1:sha256:d2c1f8176d07f8648b13614b1576ba1deb64b115c9590ff6ba52fcd17320d8f7:"
        },
        {
