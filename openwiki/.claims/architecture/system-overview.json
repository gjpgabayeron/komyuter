    {
      "id": "claim_0ad409a07b724f30a22e228bfeda102f",
      "statement": "The admin SPA is the only client of the Fastify API and reaches Postgres and Supabase Auth only through it: the admin package has no Supabase or database dependency, its environment contract is a single VITE_API_URL, and all requests go through one axios instance that attaches a Bearer token from localStorage.",
      "evidence": [
        {
          "resource": "repo://apps/admin/.env.example",
          "version": "repo-file-v1:sha256:10cee2863197272a5bdb1b0eb2120b3b7f5d84947fdb179dc4fab8e6c020291b"
