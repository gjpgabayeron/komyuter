    {
      "id": "claim_767cfe0628be413f94684d174a605319",
      "statement": "app/_layout.tsx is the only Expo Router layout: it imports @/global.css for its side effect, wraps the root `Stack` in a React Navigation `ThemeProvider` driven by `useUniwind().theme` with a `?? \"light\"` fallback, renders the `StatusBar`, mounts `PortalHost` from @rn-primitives/portal as a sibling of the stack so overlay primitives escape the navigator, and re-exports Expo Router's `ErrorBoundary`. There are no route groups, tabs or nested stacks, so all navigation is the root stack.",
      "evidence": [
        {
          "resource": "repo://apps/mobile/app/_layout.tsx#L1-L24",
          "version": "repo-lines-v1:sha256:fa9c738b1da5289e16ffd8a79b3902c0e0b8755ae094eeb194b7a5d7e42a074f:"
